# Angle limits in degrees
ANGLE_MIN = 0
ANGLE_MAX = 180

def within_limits(theta1_deg, theta2_deg):
    return (ANGLE_MIN <= theta1_deg <= ANGLE_MAX) and (ANGLE_MIN <= theta2_deg <= ANGLE_MAX)

def inverse_kinematics_select_solution(x, y, prev_theta1_deg, prev_theta2_deg):
    
    dist = math.hypot(x, y)

    # Check if the target is within reach
    if dist > (L1 + L2) or dist < abs(L1 - L2):
        return prev_theta1_deg, prev_theta2_deg

    # Compute the angle for theta2 using the Law of Cosines
    cos_angle_between_links = (x**2 + y**2 - L1**2 - L2**2) / (2 * L1 * L2)

    # Clamp due to floating-point precision errors
    if abs(cos_angle_between_links) > 1.0:
        return prev_theta1_deg, prev_theta2_deg

    angle_between_links_options = [math.acos(cos_angle_between_links), -math.acos(cos_angle_between_links)]
    valid_solutions = []

    for angle_between_links in angle_between_links_options:
        # Compute corresponding theta1
        k1 = L1 + L2 * math.cos(angle_between_links)
        k2 = L2 * math.sin(angle_between_links)
        theta1 = math.atan2(y, x) - math.atan2(k2, k1)

        # Convert to degrees and normalize
        theta1_deg = math.degrees(theta1) % 360
        if theta1_deg > 180:
            theta1_deg = 360 - theta1_deg

        # Correct θ2: 90° - (angle between links)
        theta2_deg = 90 + math.degrees(angle_between_links)
        if theta2_deg > 180:
            theta2_deg = 360 - theta2_deg

        if within_limits(theta1_deg, theta2_deg):
            valid_solutions.append((theta1_deg, theta2_deg))

    if not valid_solutions:
        return prev_theta1_deg, prev_theta2_deg
    elif len(valid_solutions) == 1:
        return valid_solutions[0]
    else:
        # Choose solution closest to previous angles
        def distance(sol):
            return abs(sol[0] - prev_theta1_deg) + abs(sol[1] - prev_theta2_deg)
        closest = min(valid_solutions, key=distance)
        return closest
    



def update_position(val=None):
    x = w.get()
    y = w2.get()

    # Calculate new position
    convertx = (l1 * math.sin(math.radians(x + offsetl1))) + 200
    converty = (l1 * math.cos(math.radians(x + offsetl1))) + 200

    convertx2 = (l2 * math.sin(math.radians(y+ x + offsetl2))) + convertx
    converty2 = (l2 * math.cos(math.radians(y+ x + offsetl2))) + converty

    # Update object position
    canvas.coords(obj,
                  convertx - obj_radius, converty - obj_radius,
                  convertx + obj_radius, converty + obj_radius)

    # Update line position
    canvas.coords(line, 200, 200, convertx, converty)

    canvas.coords(obj2,
                  convertx2 - obj_radius, converty2 - obj_radius,
                  convertx2 + obj_radius, converty2 + obj_radius)

    # Update line position
    canvas.coords(line2, convertx, converty, convertx2, converty2)


